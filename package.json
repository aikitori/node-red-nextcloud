{
  "name": "node-red-contrib-nextcloud",
  "version": "0.2.0",
  "description": "Collection of node-red nodes to download Calendars (CalDAV) and Contacts (CardDAV) and up- / download / list files (WebDAV) from / to nextcloud",
  "main": "nextcloud.js",
  "node-red": {
    "nodes": {
      "Nextcloud": "nextcloud.js"
    },
    "version": ">=2.0.0"
  },
  "keywords": [
    "node-red",
    "nextcloud",
    "owncloud",
    "webdav",
    "caldav",
    "carddav"
  ],
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "ical-expander": "^3.2.0"
  },
  "devDependencies": {
    "node-red": "^4.0.0",
    "node-red-node-test-helper": "^0.3.4",
    "standard": "^17.1.2"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "standard"
  },
  "author": "Torsten Kühnel",
  "license": "MIT",
  "maintainers": [
    {
      "name": "Torsten Kühnel",
      "email": "kuehnel.github@gmail.com"
    }
  ],
  "readme": "README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuehnelbs/node-red-contrib-nextcloud"
  },
  "engines": {
    "node": ">=18"
  },
  "standard": {
    "ignore": [
      "nextcloud.html"
    ]
  }
}
